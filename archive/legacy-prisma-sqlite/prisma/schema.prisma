generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "sqlite"
}

model AuditLog {
  id         String @id
  userId    String? @map("user_id")
  action     String
  entityId  String @map("entity_id")
  details    String
  createdAt String @map("created_at")
  users      User?  @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("audit")
  @@index([createdAt], map: "audit_created_at")
}

model BookingContact {
  bookingId String   @id @map("booking_id")
  name       String
  phone      String
  email      String    @default("")
  verified   Int       @default(0)
  bookings   Booking @relation(fields: [bookingId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("booking_contacts")
}

model Booking {
  id               String           @id
  reference        String            @unique(map: "sqlite_autoindex_bookings_2")
  accessHash      String @map("access_hash")
  customerId      String @map("customer_id")
  vehicleId       String @map("vehicle_id")
  startsAt        String @map("starts_at")
  endsAt          String @map("ends_at")
  hours            Float
  rate             BigInt
  base             BigInt
  tax              BigInt
  deposit          BigInt
  extra            BigInt               @default(0)
  status           String
  source           String
  notes            String            @default("")
  createdAt       String @map("created_at")
  contact BookingContact?
  vehicle         Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer        Customer         @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments         Payment[]       
  rental          Rental?
  checkoutItem CheckoutItem?
  addon BookingAddon?
  addonAllocations AddOnAllocation[]
  accessChallenges BookingAccessChallenge[]

  @@index([customerId], map: "booking_customer")
  @@index([vehicleId, status, startsAt, endsAt], map: "booking_availability")
  @@map("bookings")
  @@index([status, vehicleId, startsAt, endsAt], map: "booking_status_window")
  @@index([createdAt], map: "booking_created_at")
}

model BookingAccessChallenge {
  id         String   @id
  bookingId  String?  @map("booking_id")
  otpHash    String   @map("otp_hash")
  attempts   Int      @default(0)
  expiresAt  BigInt   @map("expires_at")
  consumedAt BigInt?  @map("consumed_at")
  createdAt  BigInt   @map("created_at")
  booking    Booking? @relation(fields: [bookingId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("booking_access_challenges")
  @@index([expiresAt], map: "booking_access_challenge_expiry")
}

model CustomerAccessSession {
  tokenHash  String   @id @map("token_hash")
  customerId String   @map("customer_id")
  bookingIds String   @map("booking_ids")
  expiresAt  BigInt   @map("expires_at")
  createdAt  BigInt   @map("created_at")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("customer_access_sessions")
  @@index([customerId, expiresAt], map: "customer_access_session_owner_expiry")
  @@index([expiresAt], map: "customer_access_session_expiry")
}

model Customer {
  id         String    @id
  name       String
  phone      String     @unique(map: "sqlite_autoindex_customers_2")
  email      String     @default("")
  verified   Int        @default(0)
  createdAt String @map("created_at")
  bookings   Booking[]
  accessSessions CustomerAccessSession[]
  @@map("customers")
}

model RentalInspection {
  id         String @id
  rentalId  String @map("rental_id")
  type       String
  fuel       String
  condition  String
  notes      String
  staffId   String @map("staff_id")
  createdAt String @map("created_at")
  users      User   @relation(fields: [staffId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rentals    Rental @relation(fields: [rentalId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("inspections")
  @@index([rentalId, createdAt], map: "inspection_rental_created")
}

model MaintenanceBlock {
  id         String  @id
  vehicleId String @map("vehicle_id")
  startsAt  String @map("starts_at")
  endsAt    String @map("ends_at")
  reason     String
  resolved   Int      @default(0)
  createdAt String @map("created_at")
  vehicles   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([vehicleId, startsAt, endsAt], map: "maintenance_window")

  @@map("maintenance")
  @@index([resolved, vehicleId, startsAt, endsAt], map: "maintenance_status_window")
}

model Payment {
  id         String   @id
  bookingId String @map("booking_id")
  amount     BigInt
  purpose    String
  method     String
  note       String    @default("")
  staffId   String @map("staff_id")
  createdAt String @map("created_at")
  users      User     @relation(fields: [staffId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bookings   Booking  @relation(fields: [bookingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  refunds    Refund[]

  @@map("payments")
  @@index([bookingId, createdAt], map: "payment_booking_created")
}

model Refund {
  id         String  @id
  paymentId String @map("payment_id")
  amount     BigInt
  reason     String
  staffId   String @map("staff_id")
  createdAt String @map("created_at")
  users      User    @relation(fields: [staffId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments   Payment @relation(fields: [paymentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("refunds")
  @@index([paymentId], map: "refund_payment")
}

model Rental {
  id                                String       @id
  bookingId                        String        @unique(map: "sqlite_autoindex_rentals_2") @map("booking_id")
  pickupAt                         String @map("pickup_at")
  returnAt                         String? @map("return_at")
  pickupStaff                      String @map("pickup_staff")
  returnStaff                      String? @map("return_staff")
  pickupOdometer                   Int @map("pickup_odometer")
  returnOdometer                   Int? @map("return_odometer")
  lateMinutes                      Int           @default(0) @map("late_minutes")
  lateCharge                       BigInt           @default(0) @map("late_charge")
  inspections                       RentalInspection[]
  usersRentalsReturnStaffTousers User?        @relation("rentals_return_staffTousers", fields: [returnStaff], references: [id], onDelete: NoAction, onUpdate: NoAction)
  usersRentalsPickupStaffTousers User         @relation("rentals_pickup_staffTousers", fields: [pickupStaff], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bookings                          Booking      @relation(fields: [bookingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@map("rentals")
}

model Session {
  id         String @id
  userId    String? @map("user_id")
  csrf       String
  expiresAt BigInt @map("expires_at")
  users      User?  @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("sessions")
  @@index([expiresAt], map: "session_expiration")
}

model ShopSettings {
  id   Int    @id @default(autoincrement())
  data String
  @@map("settings")
}

model User {
  id                                  String       @id
  name                                String
  email                               String        @unique(map: "sqlite_autoindex_users_2")
  passwordHash                       String @map("password_hash")
  role                                String
  active                              Int           @default(1)
  createdAt                          String @map("created_at")
  audit                               AuditLog[]      
  inspections                         RentalInspection[]
  payments                            Payment[]   
  refunds                             Refund[]    
  rentalsRentalsReturnStaffTousers Rental[]     @relation("rentals_return_staffTousers")
  rentalsRentalsPickupStaffTousers Rental[]     @relation("rentals_pickup_staffTousers")
  sessions                            Session[]   
  @@map("users")
}

model Vehicle {
  id           String       @id
  slug         String        @unique(map: "sqlite_autoindex_vehicles_2")
  name         String
  brand        String
  category     String
  registration String        @unique(map: "sqlite_autoindex_vehicles_3")
  rate         BigInt
  deposit      BigInt           @default(0)
  fuel         String
  transmission String
  seats        Int
  engine       String
  image        String
  description  String
  odometer     Int           @default(0)
  status       String        @default("Available")
  createdAt   String @map("created_at")
  bookings     Booking[]
  maintenance  MaintenanceBlock[]
  images       VehicleImage[]
  @@map("vehicles")
}

model VehicleImage {
  vehicleId String @map("vehicle_id")
  id String
  label String
  url String
  position Int
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  @@id([vehicleId, id])
  @@unique([vehicleId, position], map: "vehicle_images_position")
  @@unique([vehicleId, url], map: "vehicle_images_url")
  @@map("vehicle_images")
}

model ContactInquiry {
 id String @id
 submissionKey String @unique @map("submission_key")
 name String
 email String
 phone String @default("")
 inquiryType String @map("inquiry_type")
 message String
 status String @default("new")
 createdAt String @map("created_at")
 updatedAt String @map("updated_at")
 @@index([status, createdAt], map: "contact_inquiries_status_created")
 @@index([createdAt], map: "contact_inquiries_created")
 @@map("contact_inquiries")
}

model CheckoutOrder {
  id String @id
  submissionKey String @unique @map("submission_key")
  inputHash String @map("input_hash")
  accessHash String @map("access_hash")
  createdAt String @map("created_at")
  items CheckoutItem[]
  @@map("checkout_orders")
}

model CheckoutItem {
  bookingId String @id @map("booking_id")
  orderId String @map("order_id")
  booking Booking @relation(fields:[bookingId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  order CheckoutOrder @relation(fields:[orderId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  @@index([orderId],map:"checkout_items_order")
  @@map("checkout_items")
}

model BookingAddon {
  bookingId String @id @map("booking_id")
  quantity Int
  rate BigInt
  billing String
  base BigInt
  tax BigInt
  booking Booking @relation(fields:[bookingId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  @@map("booking_addons")
}

model AddOn {
  id String @id
  code String @unique
  name String
  description String @default("")
  image String @default("")
  rate BigInt
  billing String
  stock Int
  unserviceable Int
  maxQuantity Int @map("max_quantity")
  enabled Int
  archivedAt String? @map("archived_at")
  version Int @default(1)
  createdAt String @map("created_at")
  updatedAt String @map("updated_at")
  categories AddOnCategory[]
  allocations AddOnAllocation[]
  @@map("addons")
}

model AddOnCategory {
  addonId String @map("addon_id")
  category String
  includedQuantity Int @map("included_quantity")
  addon AddOn @relation(fields:[addonId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  @@id([addonId,category])
  @@map("addon_categories")
}

model AddOnAllocation {
  id String @id
  addonId String @map("addon_id")
  bookingId String @map("booking_id")
  quantity Int
  includedQuantity Int @map("included_quantity")
  name String
  rate BigInt
  billing String
  base BigInt
  tax BigInt
  version Int
  addon AddOn @relation(fields:[addonId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  booking Booking @relation(fields:[bookingId],references:[id],onDelete:NoAction,onUpdate:NoAction)
  @@unique([addonId,bookingId])
  @@index([bookingId],map:"addon_allocations_booking")
  @@index([addonId,bookingId],map:"addon_allocations_stock")
  @@map("addon_allocations")
}
