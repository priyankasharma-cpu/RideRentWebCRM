# Environment is loaded from the backend/.env.
# Add the private MongoDB Atlas URI here; never commit a populated .env file.
MONGODB_URI=
MONGODB_DB_NAME=riderent_rehearsal
MONGODB_DNS_SERVERS=
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173,http://localhost:3001
UPLOAD_DIR=backend/uploads
TRUST_PROXY_HOPS=0
# Booking access OTP (production): configure Resend and a persistent random secret of 32+ chars.
RESEND_API_KEY=
OTP_FROM_EMAIL=
OTP_HASH_SECRET=
# Production HTTPS: NODE_ENV=production
# Helmet/add-on rates and inventory are database-backed (admin add-on APIs).
# No production prices or stock are automatically seeded.
